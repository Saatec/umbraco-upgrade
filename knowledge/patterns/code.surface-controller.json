{
  "schemaVersion": "1.1.0",
  "id": "code.surface-controller",
  "title": "Surface controllers",
  "description": "Controllers that handle form posts from rendered pages. Some projects also use them as JSON endpoints for front-end scripts.",
  "kind": "customization",
  "area": "custom-code",
  "owner": "migrate-custom-code",
  "prevalence": "common",
  "status": "verified",
  "detection": "static",
  "flagOnly": false,
  "requiresDecision": false,
  "detectors": [
    {
      "id": "base-type",
      "weight": "strong",
      "files": [
        "**/*.cs"
      ],
      "regex": ":\\s*(?:[\\w\\.]+\\.)?SurfaceController\\b",
      "generations": [
        "v7",
        "v8",
        "v9-v13",
        "v14+"
      ]
    },
    {
      "id": "form-helper",
      "weight": "strong",
      "files": [
        "**/*.cshtml"
      ],
      "regex": "\\bBeginUmbracoForm\\b",
      "generations": [
        "v7",
        "v8",
        "v9-v13",
        "v14+"
      ]
    },
    {
      "id": "surface-url",
      "weight": "supporting",
      "files": [
        "**/*.js",
        "**/*.ts",
        "**/*.cshtml"
      ],
      "regex": "/umbraco/surface/",
      "generations": [
        "v7",
        "v8",
        "v9-v13",
        "v14+"
      ]
    }
  ],
  "impact": [
