{
  "schemaVersion": "1.1.0",
  "id": "api.runtime-file-writes",
  "title": "Runtime writes to the web root or configuration files",
  "description": "Code that writes files into the site at runtime, such as compiled assets, generated files, or values saved into configuration files.",
  "kind": "customization",
  "area": "custom-code",
  "owner": "migrate-custom-code",
  "prevalence": "common",
  "status": "hypothesis",
  "detection": "static",
  "flagOnly": false,
  "requiresDecision": false,
  "detectors": [
    {
      "id": "config-save",
      "weight": "strong",
      "files": [
        "**/*.cs"
      ],
      "regex": "OpenWebConfiguration\\s*\\([\\s\\S]{0,400}?\\.Save\\s*\\(",
      "generations": [
        "v7",
        "v8",
        "v9-v13",
        "v14+"
      ]
    },
    {
      "id": "mappath-write",
      "weight": "strong",
      "files": [
        "**/*.cs"
      ],
      "regex": "(?:MapPath|WebRootPath|ContentRootPath|MapPathWebRoot|MapPathContentRoot)\\b[\\s\\S]{0,300}?File\\.(?:WriteAll(?:Text|Bytes|Lines)|AppendAllText|Create)\\s*\\(",
      "generations": [
        "v7",
        "v8",
        "v9-v13",
        "v14+"
      ]
    },
    {
      "id": "style-compiler",
      "weight": "strong",
      "files": [
        "**/*.cs"
      ],
      "regex": "\\b\\w*(?:Sass|Scss|Less)Compiler\\b",
      "generations": [
        "v7",
        "v8",
        "v9-v13",
        "v14+"
      ]
    }
  ],
  "impact": [
    {
      "crosses": 9,
      "difficulty": "medium",
      "summary": "The web root moves and configuration files should not be written at runtime; deployments may replace written files.",
      "status": "hypothesis",
      "sources": []
    }
  ],
  "handling": [
    {
      "id": "move-outputs",
      "option": "Move outputs to a storage location outside the web root or to build time, and keep runtime values out of configuration files",
      "when": "Always",
      "targets": [
        "v9-v13",
        "v14+"
      ],
      "status": "hypothesis",
      "sources": []
    }
  ],
  "checks": [
    {
      "text": "Runtime-written files are produced in their new location on the local site",
      "verification": "manual"
    }
  ],
  "sources": []
}
