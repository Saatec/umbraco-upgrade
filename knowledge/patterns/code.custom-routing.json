{
  "schemaVersion": "1.1.0",
  "id": "code.custom-routing",
  "title": "Custom routes and areas",
  "description": "Routes or MVC areas registered outside CMS content routing, sometimes resolving content by path.",
  "kind": "customization",
  "area": "custom-code",
  "owner": "migrate-custom-code",
  "prevalence": "common",
  "status": "verified",
  "detection": "static",
  "flagOnly": false,
  "requiresDecision": false,
  "detectors": [
    {
      "id": "area-registration",
      "weight": "strong",
      "files": [
        "**/*.cs"
      ],
      "regex": "\\bAreaRegistration\\b",
      "generations": [
        "v7",
        "v8"
      ]
    },
    {
      "id": "route-table",
      "weight": "strong",
      "files": [
        "**/*.cs"
      ],
      "regex": "\\bRouteTable\\.Routes\\.MapRoute\\b|\\bMapUmbracoRoute\\b|\\bUmbracoVirtualNodeRouteHandler\\b",
      "generations": [
        "v7",
        "v8"
      ]
    },
    {
      "id": "endpoint-route",
      "weight": "strong",
      "files": [
        "**/*.cs"
      ],
      "regex": "\\.MapControllerRoute\\s*\\(|\\bIVirtualPageController\\b",
      "generations": [
        "v9-v13",
        "v14+"
      ]
    },
    {
      "id": "content-by-route",
      "weight": "strong",
      "files": [
        "**/*.cs",
        "**/*.cshtml",
        "**/*.vb",
        "**/*.vbhtml"
      ],
      "regex": "\\.GetByRoute\\s*\\(",
      "generations": [
        "v7",
        "v8",
        "v9-v13",
        "v14+"
      ]
    }
  ],
  "impact": [
    {
      "crosses": 9,
      "difficulty": "medium",
      "summary": "Custom routes are registered with endpoint routing in the startup code.",
      "status": "verified",
      "sources": [
        {
          "url": "https://docs.umbraco.com/umbraco-cms/13.latest/reference/routing/custom-routes.md",
          "docsVersion": "13",
          "appliesTo": "9-13",
          "verifiedAt": "2026-10-29",
          "evidence": "within the WithEndpoints method call"
        }
      ]
    },
    {
      "crosses": 14,
      "difficulty": "low",
      "summary": "Custom routes are documented the same way for the new backoffice generation.",
      "status": "verified",
      "sources": [
        {
          "url": "https://docs.umbraco.com/umbraco-cms/17.latest/develop-with-umbraco/application-code/backend-and-custom-logic/routing/custom-routes.md",
          "docsVersion": "17",
          "appliesTo": "14+",
          "verifiedAt": "2026-10-29",
          "evidence": "Setting up your own controllers and routes that exist alongside the Umbraco pipeline"
        }
      ]
    }
  ],
  "handling": [
    {
      "id": "endpoint-routing",
      "option": "Register routes with endpoint routing inside the CMS pipeline startup",
      "when": "The route maps to a controller",
      "targets": [
        "v9-v13",
        "v14+"
      ],
      "status": "verified",
      "sources": [
        {
          "url": "https://docs.umbraco.com/umbraco-cms/13.latest/reference/routing/custom-routes.md",
          "docsVersion": "13",
          "appliesTo": "9-13",
          "verifiedAt": "2026-10-29",
          "evidence": "within the WithEndpoints method call"
        },
        {
          "url": "https://docs.umbraco.com/umbraco-cms/17.latest/develop-with-umbraco/application-code/backend-and-custom-logic/routing/custom-routes.md",
          "docsVersion": "17",
          "appliesTo": "14+",
          "verifiedAt": "2026-10-29",
          "evidence": "Setting up your own controllers and routes that exist alongside the Umbraco pipeline"
        }
      ]
    },
    {
      "id": "content-lookup-service",
      "option": "Resolve content by path through the content query services of the target",
      "when": "Code resolves content by path",
      "targets": [
        "v9-v13",
        "v14+"
      ],
      "status": "hypothesis",
      "sources": []
    }
  ],
  "checks": [
    {
      "text": "Every custom route answers as before on the local site",
      "verification": "manual"
    }
  ],
  "sources": []
}
