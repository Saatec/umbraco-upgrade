{
  "schemaVersion": "1.1.0",
  "id": "code.render-controller",
  "title": "Custom render controllers (route hijacking)",
  "description": "A controller named after a content type, or a global default controller, intercepts page rendering to build a view model or run logic before the template renders.",
  "kind": "customization",
  "area": "custom-code",
  "owner": "migrate-custom-code",
  "prevalence": "common",
  "status": "verified",
  "detection": "static",
  "flagOnly": false,
  "requiresDecision": false,
  "detectors": [
    {
      "id": "legacy-base-type",
      "weight": "strong",
      "files": [
        "**/*.cs"
      ],
      "regex": ":\\s*(?:[\\w\\.]+\\.)?RenderMvcController\\b",
      "generations": [
        "v7",
        "v8"
      ]
    },
    {
      "id": "legacy-default-controller",
      "weight": "strong",
      "files": [
        "**/*.cs"
      ],
      "regex": "\\bDefaultRenderMvcControllerResolver\\b",
      "generations": [
        "v7",
        "v8"
      ]
    },
    {
      "id": "core-base-type",
      "weight": "strong",
      "files": [
        "**/*.cs"
      ],
      "regex": ":\\s*(?:[\\w\\.]+\\.)?RenderController\\b",
      "generations": [
        "v9-v13",
        "v14+"
      ]
    },
    {
      "id": "core-interface",
      "weight": "strong",
      "files": [
        "**/*.cs"
      ],
      "regex": "\\bIRenderController\\b",
      "generations": [
        "v9-v13",
        "v14+"
      ]
    },
    {
      "id": "core-default-controller",
      "weight": "strong",
      "files": [
        "**/*.cs"
      ],
      "regex": "\\bUmbracoRenderingDefaultsOptions\\b",
      "generations": [
        "v9-v13",
        "v14+"
      ]
    }
  ],
  "impact": [
    {
      "crosses": 9,
      "difficulty": "medium",
      "summary": "In the ASP.NET Core generation, front-end requests route through the core render controller, which custom controllers replace per content type.",
      "status": "verified",
      "sources": [
        {
          "url": "https://docs.umbraco.com/umbraco-cms/13.latest/reference/routing/custom-controllers.md",
          "docsVersion": "13",
          "appliesTo": "9-13",
          "verifiedAt": "2026-10-29",
          "evidence": "all front-end requests to an Umbraco site are auto-routed via the 'Index' action of a core Controller"
        }
      ]
    },
    {
      "crosses": 14,
      "difficulty": "low",
      "summary": "Route hijacking is documented the same way for the new backoffice generation.",
      "status": "verified",
      "sources": [
        {
          "url": "https://docs.umbraco.com/umbraco-cms/17.latest/develop-with-umbraco/application-code/backend-and-custom-logic/routing/custom-controllers.md",
          "docsVersion": "17",
          "appliesTo": "14+",
          "verifiedAt": "2026-10-29",
          "evidence": "all front-end requests to an Umbraco site are auto-routed via the 'Index' action of a core Controller"
        }
      ]
    }
  ],
  "handling": [
    {
      "id": "port-render-controller",
      "option": "Port each controller to the target render controller base type with constructor injection",
      "when": "Controller logic is small and page-specific",
      "targets": [
        "v9-v13",
        "v14+"
      ],
      "status": "verified",
      "sources": [
        {
          "url": "https://docs.umbraco.com/umbraco-cms/13.latest/reference/routing/custom-controllers.md",
          "docsVersion": "13",
          "appliesTo": "9-13",
          "verifiedAt": "2026-10-29",
          "evidence": "all front-end requests to an Umbraco site are auto-routed via the 'Index' action of a core Controller"
        },
        {
          "url": "https://docs.umbraco.com/umbraco-cms/17.latest/develop-with-umbraco/application-code/backend-and-custom-logic/routing/custom-controllers.md",
          "docsVersion": "17",
          "appliesTo": "14+",
          "verifiedAt": "2026-10-29",
          "evidence": "all front-end requests to an Umbraco site are auto-routed via the 'Index' action of a core Controller"
        }
      ]
    },
    {
      "id": "move-logic-to-services",
      "option": "Move page logic into view components or services and keep a thin controller",
      "when": "Controllers hold shared or heavy logic",
      "targets": [
        "v9-v13",
        "v14+"
      ],
      "status": "hypothesis",
      "sources": [
        {
          "url": "https://learn.microsoft.com/en-us/aspnet/core/mvc/views/view-components",
          "docsVersion": "dotnet",
          "appliesTo": "dotnet",
          "verifiedAt": "2026-10-29",
          "evidence": "View components are similar to partial views, but they're much more powerful"
        }
      ]
    }
  ],
  "checks": [
    {
      "text": "Each hijacked content type still renders through its controller (request a page of each type on the local site)",
      "verification": "manual"
    }
  ],
  "sources": [
    {
      "url": "https://raw.githubusercontent.com/umbraco/UmbracoDocs/legacy-docs/Reference/Routing/Custom-Controllers/index-v7.md",
      "appliesTo": "7",
      "fetchedAt": "2026-10-12"
    },
    {
      "url": "https://docs.umbraco.com/umbraco-cms/13.latest/reference/routing/custom-controllers.md",
      "appliesTo": "13",
      "fetchedAt": "2026-10-12"
    }
  ]
}
