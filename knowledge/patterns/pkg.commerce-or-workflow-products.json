{
  "schemaVersion": "1.1.0",
  "id": "pkg.commerce-or-workflow-products",
  "title": "Commerce and workflow add-on products",
  "description": "Commerce or editorial workflow products with their own upgrade guides.",
  "kind": "customization",
  "area": "packages-backoffice",
  "owner": "migrate-packages-backoffice",
  "prevalence": "gap",
  "status": "hypothesis",
  "detection": "static",
  "flagOnly": true,
  "requiresDecision": true,
  "detectors": [
    {
      "id": "product-package",
      "weight": "strong",
      "files": [
        "**/*.csproj",
        "**/*.vbproj",
        "**/packages.config",
        "**/Directory.Packages.props"
      ],
      "regex": "(?:\\bid|\\bInclude)\\s*=\\s*\"(?:Umbraco\\.Commerce(?:\\.[\\w\\.]+)?|Vendr(?:\\.[\\w\\.]+)?|UCommerce(?:\\.[\\w\\.]+)?|Umbraco\\.Workflow(?:\\.[\\w\\.]+)?)\"",
      "generations": [
        "v7",
        "v8",
        "v9-v13",
        "v14+"
      ]
    }
  ],
  "impact": [
    {
      "crosses": 9,
      "difficulty": "high",
      "summary": "These products follow their own upgrade guides and licensing.",
      "status": "hypothesis",
      "sources": []
    }
  ],
  "handling": [
    {
      "id": "product-guide",
      "option": "Follow the product upgrade guide for the exact versions (the user confirms the license)",
      "when": "Always",
      "targets": [
        "v9-v13",
        "v14+"
      ],
      "status": "hypothesis",
      "sources": []
    }
  ],
  "checks": [
    {
      "text": "The product upgrade guide steps are recorded with citations",
      "verification": "manual"
    }
  ],
  "sources": []
}
