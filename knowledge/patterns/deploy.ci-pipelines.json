{
  "schemaVersion": "1.1.0",
  "id": "deploy.ci-pipelines",
  "title": "CI and CD pipeline definitions",
  "description": "Pipeline definitions and build templates, often pinned to SDK, MSBuild, or Node versions.",
  "kind": "customization",
  "area": "deployment-rehearsal",
  "owner": "deployment-rehearsal",
  "prevalence": "common",
  "status": "hypothesis",
  "detection": "static",
  "flagOnly": false,
  "requiresDecision": false,
  "detectors": [
    {
      "id": "pipeline-file",
      "weight": "strong",
      "files": [
        ".github/workflows/*.yml",
        ".github/workflows/*.yaml",
        "**/azure-pipelines*.yml",
        "**/.gitlab-ci.yml",
        "**/Jenkinsfile",
        "**/bitbucket-pipelines.yml",
        "**/appveyor.yml",
        "**/BuildProcessTemplates/*.xaml"
      ],
      "generations": [
        "v7",
        "v8",
        "v9-v13",
        "v14+"
      ]
    }
  ],
  "impact": [
    {
      "crosses": 9,
      "difficulty": "medium",
      "summary": "Pipelines need the SDK and build steps of the target framework.",
      "status": "hypothesis",
      "sources": []
    }
  ],
  "handling": [
    {
      "id": "update-pipeline",
      "option": "Update SDK versions and build steps, with an approval for each change",
      "when": "Always",
      "targets": [
        "v9-v13",
        "v14+"
      ],
      "status": "hypothesis",
      "sources": [],
      "requiresApproval": "ci-deploy-config-change"
    }
  ],
  "checks": [
    {
      "text": "The pipeline change is reviewed by the user; nothing is deployed by the plugin",
      "verification": "manual"
    }
  ],
  "sources": []
}
