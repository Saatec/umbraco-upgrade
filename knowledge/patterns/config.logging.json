{
  "schemaVersion": "1.1.0",
  "id": "config.logging",
  "title": "Legacy logging libraries",
  "description": "Custom logging setup with legacy libraries or the logging helpers of older generations.",
  "kind": "customization",
  "area": "custom-code",
  "owner": "migrate-custom-code",
  "prevalence": "common",
  "status": "verified",
  "detection": "static",
  "flagOnly": false,
  "requiresDecision": false,
  "detectors": [
    {
      "id": "log4net",
      "weight": "strong",
      "files": [
        "**/*.cs",
        "**/*.csproj",
        "**/*.vbproj",
        "**/packages.config",
        "**/Directory.Packages.props",
        "**/*.config"
      ],
      "regex": "\\blog4net\\b",
      "generations": [
        "v7",
        "v8",
        "v9-v13",
        "v14+"
      ]
    },
    {
      "id": "log-helper",
      "weight": "strong",
      "files": [
        "**/*.cs"
      ],
      "regex": "\\bLogHelper\\.(?:Info|Warn|Error|Debug)\\b",
      "generations": [
        "v7"
      ]
    },
    {
      "id": "v8-logger-api",
      "weight": "strong",
      "files": [
        "**/*.cs"
      ],
      "regex": "\\b(?:_?logger|Logger)\\.(?:Info|Warn|Error|Debug)\\s*<",
      "generations": [
        "v8"
      ]
    }
  ],
  "impact": [
    {
      "crosses": 9,
      "difficulty": "low",
      "summary": "From 9 the CMS logs through Serilog behind the .NET logging API.",
      "status": "verified",
      "sources": [
        {
          "url": "https://docs.umbraco.com/umbraco-cms/13.latest/fundamentals/code/debugging/logging.md",
          "docsVersion": "13",
          "appliesTo": "9-13",
          "verifiedAt": "2026-10-29",
          "evidence": "In Umbraco we use the underlying logging framework of"
        },
        {
          "url": "https://learn.microsoft.com/en-us/dotnet/core/extensions/logging",
          "docsVersion": "dotnet",
          "appliesTo": "dotnet",
          "verifiedAt": "2026-10-29",
          "evidence": "to help monitor application behavior and diagnose issues"
        }
      ]
    }
  ],
  "handling": [
    {
      "id": "ilogger",
      "option": "Use ILogger<T> and the Serilog section of appsettings.json",
      "when": "Always",
      "targets": [
        "v9-v13",
        "v14+"
      ],
      "status": "verified",
      "sources": [
        {
          "url": "https://docs.umbraco.com/umbraco-cms/13.latest/fundamentals/code/debugging/logging.md",
          "docsVersion": "13",
          "appliesTo": "9-13",
          "verifiedAt": "2026-10-29",
          "evidence": "In Umbraco we use the underlying logging framework of"
        },
        {
          "url": "https://docs.umbraco.com/umbraco-cms/17.latest/develop-with-umbraco/testing-and-debugging/logging.md",
          "docsVersion": "17",
          "appliesTo": "14+",
          "verifiedAt": "2026-10-29",
          "evidence": "In Umbraco we use the underlying logging framework of"
        },
        {
          "url": "https://learn.microsoft.com/en-us/dotnet/core/extensions/logging",
          "docsVersion": "dotnet",
          "appliesTo": "dotnet",
          "verifiedAt": "2026-10-29",
          "evidence": "to help monitor application behavior and diagnose issues"
        }
      ]
    }
  ],
  "checks": [
    {
      "text": "Log entries from custom code appear in the CMS log on the local site",
      "verification": "manual"
    }
  ],
  "sources": []
}
