{
  "schemaVersion": "1.1.0",
  "id": "api.health-checks",
  "title": "Custom health checks",
  "description": "Custom checks for the backoffice health check dashboard.",
  "kind": "customization",
  "area": "custom-code",
  "owner": "migrate-custom-code",
  "prevalence": "gap",
