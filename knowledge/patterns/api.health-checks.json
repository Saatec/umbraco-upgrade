        },
        {
          "url": "https://docs.umbraco.com/umbraco-cms/17.latest/run-in-production/infrastructure-and-ops/health-check.md",
          "docsVersion": "17",
          "appliesTo": "14+",
          "verifiedAt": "2026-10-29",
          "evidence": "It's possible to add your custom-built health checks"
