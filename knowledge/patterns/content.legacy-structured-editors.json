{
  "schemaVersion": "1.1.0",
  "id": "content.legacy-structured-editors",
  "title": "Nested Content and other legacy structured editors",
  "description": "Repeatable structured content stored by legacy editors such as Nested Content (core or package versions).",
  "kind": "customization",
  "area": "content-database",
  "owner": "migrate-content-database",
  "prevalence": "common",
  "status": "verified",
  "detection": "static",
  "flagOnly": false,
  "requiresDecision": false,
  "detectors": [
    {
      "id": "nested-content-alias",
      "weight": "strong",
      "files": [
        "**/*.config",
        "**/*.json",
        "**/*.xml",
        "**/*.config.js",
        "**/*.uda",
        "**/*.cs",
        "**/*.cshtml"
      ],
      "regex": "\\b(?:Our\\.)?Umbraco\\.NestedContent\\b",
      "generations": [
        "v7",
        "v8",
        "v9-v13",
        "v14+"
      ]
    },
    {
      "id": "nested-content-config",
      "weight": "strong",
      "files": [
        "**/*.json",
        "**/*.config",
        "**/*.xml"
      ],
      "regex": "\"ncContentTypeAlias\"",
      "generations": [
        "v7",
        "v8",
        "v9-v13",
        "v14+"
      ]
    }
  ],
  "impact": [
    {
      "crosses": 8,
      "difficulty": "medium",
      "summary": "The 7 to 8 content migration fails while obsolete editors, Nested Content included, are still in use.",
      "status": "verified",
      "sources": [
        {
          "url": "https://docs.umbraco.com/umbraco-cms/get-started/upgrading-and-migrating/find-your-upgrade-path/migrate-content-to-umbraco-8.md",
          "docsVersion": "18",
          "appliesTo": "8",
          "verifiedAt": "2026-10-29",
          "evidence": "The migration will fail if you are still using obsolete properties"
        }
      ]
    },
    {
      "crosses": 14,
      "difficulty": "high",
      "summary": "Nested Content is removed; content moves to the block list or block grid with a data conversion.",
      "status": "verified",
      "sources": [
        {
          "url": "https://docs.umbraco.com/umbraco-cms/get-started/upgrading-and-migrating/version-specific.md",
          "docsVersion": "18",
          "appliesTo": "14+",
          "verifiedAt": "2026-10-29",
          "evidence": "Nested Content and Grid Layout have been removed"
        },
        {
          "url": "https://docs.umbraco.com/umbraco-cms/get-started/upgrading-and-migrating/version-specific.md",
          "docsVersion": "18",
          "appliesTo": "14+",
          "verifiedAt": "2026-10-29",
          "evidence": "The recommended action is to use blocks instead - Block Grid for the grid layout and either Block Grid or Block List for Nested Content"
        },
        {
          "url": "https://docs.umbraco.com/umbraco-cms/13.latest/fundamentals/backoffice/property-editors/built-in-umbraco-property-editors/block-editor/block-list-editor.md",
          "docsVersion": "13",
          "appliesTo": "9-13",
          "verifiedAt": "2026-10-29",
          "evidence": "The Block List replaces the obsolete Nested Content editor"
        }
      ]
    }
  ],
  "handling": [
    {
      "id": "block-list-conversion",
      "option": "Convert to the block list (or block grid) with a data conversion tested on the local copy",
      "when": "Target 14 or later",
      "targets": [
        "v14+"
      ],
      "status": "verified",
      "sources": [
        {
          "url": "https://docs.umbraco.com/umbraco-cms/get-started/upgrading-and-migrating/version-specific.md",
          "docsVersion": "18",
          "appliesTo": "14+",
          "verifiedAt": "2026-10-29",
          "evidence": "The recommended action is to use blocks instead - Block Grid for the grid layout and either Block Grid or Block List for Nested Content"
        },
        {
          "url": "https://docs.umbraco.com/umbraco-cms/13.latest/fundamentals/backoffice/property-editors/built-in-umbraco-property-editors/block-editor/block-list-editor.md",
          "docsVersion": "13",
          "appliesTo": "9-13",
          "verifiedAt": "2026-10-29",
          "evidence": "The Block List replaces the obsolete Nested Content editor"
        }
      ]
    },
    {
      "id": "deploy-import-migration",
      "option": "Use an import with migrations to transform the data during transfer",
      "when": "The project uses the vendor deployment tool",
      "targets": [
        "v14+"
      ],
      "status": "verified",
      "sources": [
        {
          "url": "https://docs.umbraco.com/umbraco-deploy/17.latest/deployment-workflow/import-export/import-with-migrations.md",
          "docsVersion": "17",
          "appliesTo": "14+",
          "verifiedAt": "2026-10-29",
          "evidence": "you can migrate from a Nested Content property in Umbraco 8 to a Block List in Umbraco 13"
        }
      ]
    },
    {
      "id": "keep-on-13",
      "option": "Keep Nested Content on a 13 target and plan the conversion",
      "when": "Target 13 or earlier",
      "targets": [
        "v9-v13"
      ],
      "status": "verified",
      "sources": [
        {
          "url": "https://docs.umbraco.com/umbraco-cms/13.latest/fundamentals/backoffice/property-editors/built-in-umbraco-property-editors/block-editor/block-list-editor.md",
          "docsVersion": "13",
          "appliesTo": "9-13",
          "verifiedAt": "2026-10-29",
          "evidence": "The Block List replaces the obsolete Nested Content editor"
        }
      ]
    }
  ],
  "checks": [
    {
      "text": "Every property that used Nested Content holds the converted items on the local copy",
      "verification": "manual"
    }
  ],
  "sources": []
}
