{
  "schemaVersion": "1.1.0",
  "id": "config.committed-secrets",
  "title": "Secrets in tracked configuration",
  "description": "Connection strings with credentials, API keys, machine keys, and similar values in configuration files. Default installations often hold a connection string with a password, so it is a baseline signal that is always flagged.",
  "kind": "baseline",
  "area": "config-auth-integrations",
  "owner": "migrate-config-auth-integrations",
  "involves": [
    "discovery"
  ],
  "prevalence": "common",
  "status": "verified",
  "detection": "static",
  "flagOnly": false,
  "requiresDecision": false,
  "detectors": [
    {
      "id": "connection-password",
      "weight": "strong",
      "files": [
        "**/*.config",
        "**/appsettings*.json",
        "**/*.pubxml"
      ],
      "regex": "(?i)(?:password|pwd)\\s*=\\s*[^;\"'\\s<>]{3,}",
      "generations": [
        "v7",
        "v8",
        "v9-v13",
        "v14+"
      ]
    },
    {
      "id": "json-secret",
      "weight": "strong",
      "files": [
        "**/appsettings*.json"
      ],
      "regex": "(?i)\"\\w*(?:apikey|api_key|secret|token|password|clientsecret)\"\\s*:\\s*\"[^\"]{6,}\"",
      "generations": [
        "v7",
        "v8",
        "v9-v13",
        "v14+"
      ]
    },
    {
      "id": "machine-key",
      "weight": "strong",
      "files": [
        "**/web.config",
        "**/Web.config"
      ],
      "regex": "<machineKey\\b[^>]*\\b(?:validationKey|decryptionKey)=\"[^\"]{8,}\"",
      "generations": [
        "v7",
        "v8"
      ]
    }
  ],
  "impact": [
    {
      "crosses": 9,
      "difficulty": "low",
      "summary": "Documented secret stores: user secrets for development and a key vault for servers.",
      "status": "verified",
      "sources": [
        {
          "url": "https://learn.microsoft.com/en-us/aspnet/core/security/app-secrets",
          "docsVersion": "dotnet",
          "appliesTo": "dotnet",
          "verifiedAt": "2026-10-29",
          "evidence": "Safe storage of app secrets in development in ASP.NET Core"
        },
        {
          "url": "https://docs.umbraco.com/umbraco-cms/13.latest/extending/key-vault.md",
          "docsVersion": "13",
          "appliesTo": "9-13",
          "verifiedAt": "2026-10-29",
          "evidence": "From a security perspective, storing your application secrets in Azure Key Vault is always a good solution"
        }
      ]
    }
  ],
  "handling": [
    {
      "id": "secret-store",
      "option": "Move secrets to user secrets for development and to environment variables or a vault for servers; redact them in all evidence",
      "when": "Always",
      "targets": [
        "v9-v13",
        "v14+"
      ],
      "status": "verified",
      "sources": [
        {
          "url": "https://learn.microsoft.com/en-us/aspnet/core/security/app-secrets",
          "docsVersion": "dotnet",
          "appliesTo": "dotnet",
          "verifiedAt": "2026-10-29",
          "evidence": "Safe storage of app secrets in development in ASP.NET Core"
        },
        {
          "url": "https://docs.umbraco.com/umbraco-cms/13.latest/extending/key-vault.md",
          "docsVersion": "13",
          "appliesTo": "9-13",
          "verifiedAt": "2026-10-29",
          "evidence": "From a security perspective, storing your application secrets in Azure Key Vault is always a good solution"
        }
      ]
    }
  ],
  "checks": [
    {
      "text": "No new secret value is added to a tracked file during the upgrade (checkpoint scan)",
      "verification": "automated"
    }
  ],
  "sources": []
}
