<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" Version="13.10.1" />
    <PackageReference Include="Sample.Community.Editor" Version="2.1.0" />
    <PackageReference Include="Sample.Modern.Grid" Version="13.1.0" />
    <PackageReference Include="Sample.Open.Range" Version="1.2.0" />
    <PackageReference Include="Sample.Utility" Version="5.0.0" />
    <PackageReference Include="Sample.Private.Toolkit" Version="1.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>

  <PropertyGroup>
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>
</Project>
