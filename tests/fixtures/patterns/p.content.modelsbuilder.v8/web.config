<?xml version="1.0" encoding="utf-8"?>
<!-- Synthetic fixture: minimal Umbraco 8 web.config with a source-code models mode. Values are fake. -->
<configuration>
  <configSections>
    <sectionGroup name="umbracoConfiguration">
      <section name="settings" type="Umbraco.Core.Configuration.UmbracoSettings.UmbracoSettingsSection, Umbraco.Core" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <umbracoConfiguration>
    <settings configSource="config\umbracoSettings.config" />
  </umbracoConfiguration>
  <appSettings>
    <add key="Umbraco.Core.ConfigurationStatus" value="8.18.8" />
    <add key="Umbraco.Core.ReservedUrls" value="" />
    <add key="Umbraco.Core.ReservedPaths" value="~/app_plugins/,~/install/,~/mini-profiler-resources/," />
    <add key="Umbraco.Core.Path" value="~/umbraco" />
    <add key="Umbraco.Core.UseHttps" value="false" />
    <add key="Umbraco.ModelsBuilder.Enable" value="true" />
    <add key="Umbraco.ModelsBuilder.ModelsMode" value="AppData" />
  </appSettings>
  <connectionStrings>
    <remove name="umbracoDbDSN" />
    <add name="umbracoDbDSN" connectionString="Data Source=(local);Initial Catalog=SampleSite;User ID=sample_user;Password=FAKE-SECRET-FOR-TESTS-db-password" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation defaultLanguage="c#" debug="false" targetFramework="4.7.2" />
    <httpRuntime requestValidationMode="2.0" enableVersionHeader="false" targetFramework="4.7.2" />
  </system.web>
</configuration>
